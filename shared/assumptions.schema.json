{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yz-musa-final/shared/assumptions.schema.json",
  "title": "Money model assumptions",
  "description": "Every number the cost, rent and pay-off model uses. Each item carries its source, date and confidence.",
  "type": "object",
  "required": ["version", "currency", "places", "adu_types", "items"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "currency": {"type": "string"},
    "places": {"type": "array", "items": {"enum": ["philadelphia", "pittsburgh", "rest_of_pa"]}, "minItems": 3, "uniqueItems": true},
    "adu_types": {"type": "array", "items": {"enum": ["detached_new", "garage_conversion", "over_garage", "internal", "attached"]}, "minItems": 5, "uniqueItems": true},
    "items": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
      "additionalProperties": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["title", "url", "date"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "url": {"type": "string", "description": "Empty only for owner settings"},
        "date": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$", "description": "Date of the source. Undated pages carry the day they were read."}
      }
    },
    "item": {
      "type": "object",
      "required": ["label", "unit", "confidence", "sources", "note"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 3},
        "unit": {"type": "string"},
        "value": {"type": "number"},
        "low": {"type": "number"},
        "mid": {"type": "number"},
        "high": {"type": "number"},
        "table": {"type": "object"},
        "note": {"type": "string"},
        "confidence": {"enum": ["measured", "published", "vendor", "assumption"]},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      },
      "oneOf": [
        {"required": ["value"], "not": {"anyOf": [{"required": ["low"]}, {"required": ["table"]}]}},
        {"required": ["low", "mid", "high"], "not": {"anyOf": [{"required": ["value"]}, {"required": ["table"]}]}},
        {"required": ["table"], "not": {"anyOf": [{"required": ["value"]}, {"required": ["low"]}]}}
      ],
      "if": {"properties": {"confidence": {"enum": ["measured", "published", "vendor"]}}},
      "then": {"properties": {"sources": {"items": {"properties": {"url": {"minLength": 8}}}}}}
    }
  }
}
