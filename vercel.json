{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app/",
      "destination": "/",
      "permanent": false
    }
  ],
  "functions": {
    "api/agent.ts": {
      "maxDuration": 30,
      "memory": 512
    }
  }
}
